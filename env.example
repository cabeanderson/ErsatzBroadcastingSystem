# Deployment configuration for the offline tooling.
#
#   cp env.example .env && $EDITOR .env
#   set -a && . ./.env && set +a
#
# .env is gitignored. Every variable below is optional — the defaults in
# scripts/config.py are correct for the framework running inside the ErsatzTV
# container, and you only need these when running the filler, nfo and testing
# tools from a workstation.

# Where the media library actually is on THIS machine. Inside the container
# this is /media; on a workstation it is wherever the share is mounted.
#ETV_MEDIA_ROOT=/media

# Only set these if your tree does not sit directly under ETV_MEDIA_ROOT.
#ETV_MOVIES_ROOT=/media/movies
#ETV_TV_ROOT=/media/tv
#ETV_FILLER_ROOT=/media/filler
#ETV_STAGING_ROOT=/media/.staging

# The ErsatzTV server, for the tools that read the live guide.
#ETV_URL=http://127.0.0.1:8409
#ETV_HOST=127.0.0.1
#ETV_PORT=8409

# Only if these are not on PATH.
#ETV_FFMPEG=ffmpeg
#ETV_FFPROBE=ffprobe
